# Copy this file to ".env" and fill in real values. Never commit ".env".

# development | production
UEMP_ENV=development

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Leave empty to use SQLite (instance/uemp.db). For PostgreSQL:
#   DATABASE_URL=postgresql://user:password@host:5432/uemp
# Neon (copy from Neon -> Connect, pooled):
#   DATABASE_URL=postgresql://neondb_owner:...@ep-xxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Set to 1 to create tables and load demo data automatically on first start.
AUTO_SEED=0
